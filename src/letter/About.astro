---
import type { Conference, Lang } from '../content/schema';
import { ui } from '../i18n/ui';
import { md, mdInline } from '../lib/markdown';
import Page from './Page.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
const ui_ = ui[lang];
const t = ui_.letter;
---

<Page lang={lang} conference={c} n={2} kicker={t.pages.about} title={t.titles.about}>
  <div class="lead md" set:html={md(c.invitation[lang])} />
  <div class="aim">
    <span class="kick">{ui_.sections.aim}</span>
    <p set:html={mdInline(c.aim[lang])} />
  </div>
  <div class="kick">{ui_.sections.organizers}</div>
  <ul class="orgs">
    {
      c.organizers.map((o) => (
        <li>
          {o.logo && <img src={o.logo} alt="" />}
          <a href={o.href}>{o.name[lang]}</a>
        </li>
      ))
    }
  </ul>
  <div class="two">
    <div class="soft">
      <div class="kick">{ui_.sections.venue}</div>
      <h3><a href={c.venue.url[lang]}>{c.venue.name[lang]}</a></h3>
      <p class="muted small">
        {c.venue.address[lang]}
        {c.venue.director && <><br />{ui_.venueDirector}: {c.venue.director[lang]}</>}
      </p>
    </div>
    <div class="soft">
      <div class="kick">{t.format}</div>
      <h3>{c.venue.format[lang]}</h3>
      <div class="kick" style="margin-top: 14px">{ui_.sections.languages}</div>
      <h3 set:html={mdInline(c.languages[lang])} />
    </div>
  </div>
</Page>

<style>
  .lead {
    margin-bottom: 24px;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 21px;
    line-height: 1.45;
    color: var(--deep);
  }

  .aim {
    margin-bottom: 24px;
    border-left: 4px solid var(--red);
    padding: 4px 0 4px 18px;
    font-size: 16px;
    font-weight: 600;
    color: var(--deep);
  }

  .aim p {
    margin: 4px 0 0;
  }

  .orgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 22px;
    margin: 12px 0 24px;
    padding: 0;
    list-style: none;
  }

  .orgs li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .orgs img {
    flex: none;
    width: 38px;
    height: 38px;
  }

  .orgs a,
  h3 a {
    text-decoration: none;
  }

  .soft .kick {
    margin-bottom: 8px;
  }

  .small {
    font-size: 13px;
  }
</style>
