---
import type { Conference, Lang } from '../content/schema';
import { ui } from '../i18n/ui';
import { parseCommittees } from '../lib/letter';
import { mdInline } from '../lib/markdown';
import Page from './Page.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
const t = ui[lang].letter;
// Verbatim from the call for papers: no names or institutions are shortened here.
const committees = parseCommittees(c.committees[lang]);
---

<Page lang={lang} conference={c} n={6} kicker={t.pages.committees} title={t.titles.committees}>
  {
    committees.map((committee, i) => (
      <div class="com">
        <h3 class:list={{ 'com__title--second': i > 0 }}>{committee.title}</h3>
        {committee.groups.map((g) => (
          <>
            {g.role && <div class="com__role">{g.role}</div>}
            <div class="com__members">
              {g.members.map((m) => (
                <p set:html={mdInline(m)} />
              ))}
            </div>
          </>
        ))}
      </div>
    ))
  }
</Page>

<style>
  .com + .com {
    margin-top: 14px;
  }

  .com h3 {
    margin-bottom: 2px;
    font-size: 19px;
  }

  .com__title--second {
    color: var(--red);
  }

  .com__role {
    margin: 4px 0 4px;
    border-top: 1px solid var(--line);
    padding-top: 5px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .com__members {
    columns: 2;
    column-gap: 26px;
    font-size: 11.7px;
    line-height: 1.36;
  }

  .com__members p {
    margin: 0 0 5px;
    break-inside: avoid;
  }

  .com__members :global(strong) {
    color: var(--deep);
  }
</style>
