---
import type { Lang } from '../content/schema';
import './letter.css';

interface Props {
  lang: Lang;
  title: string;
  /** The year whose committed PDFs the build must check (absent when the year links its own info letter). */
  check?: number;
}

const { lang, title, check } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex">
    {check && <meta name="letter-check" content={String(check)} />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <slot />
  </body>
</html>
