---
import type { Lang, Site } from '../../content/schema';
import { ui } from '../../i18n/ui';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  site: Site;
}

const { lang, site } = Astro.props;
---

<Section id="partners" title={ui[lang].sections.partners} tone="surface">
  <ul class="partners">
    {
      site.partners.map((p) => (
        <li>
          <a class="partner" href={p.href} target="_blank" rel="noopener" title={p.name}>
            <img src={p.image} alt={p.name} loading="lazy" />
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* Flex instead of grid so an incomplete last row is centred (7 partners → 4 + 3). */
  .partners {
    --per-row: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners > li {
    flex: 0 0 calc((100% - (var(--per-row) - 1) * 1rem) / var(--per-row));
  }

  @media (min-width: 900px) {
    .partners {
      --per-row: 4;
      gap: 1.25rem;
    }

    .partners > li {
      flex-basis: calc((100% - 3 * 1.25rem) / 4);
    }
  }

  .partner {
    display: grid;
    place-items: center;
    height: clamp(8rem, 14vw, 11rem);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    transition:
      background-color 0.2s,
      transform 0.2s;
  }

  .partner img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: clamp(5rem, 9vw, 7.5rem);
    object-fit: contain;
    /* Some logo files have an opaque white background; multiply drops it onto the card colour. */
    mix-blend-mode: multiply;
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter 0.2s,
      opacity 0.2s;
  }

  .partner:hover,
  .partner:focus-visible {
    background: var(--color-primary-soft);
    transform: translateY(-2px);
  }

  .partner:hover img,
  .partner:focus-visible img {
    filter: none;
    opacity: 1;
  }
</style>
