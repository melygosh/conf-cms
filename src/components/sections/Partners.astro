---
import type { Lang, Site } from '../../content/schema';
import { ui } from '../../i18n/ui';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  site: Site;
}

const { lang, site } = Astro.props;
---

<Section id="partners" title={ui[lang].sections.partners}>
  <ul class="partners">
    {
      site.partners.map((p) => (
        <li>
          <a class="partner" href={p.href} target="_blank" rel="noopener" title={p.name}>
            <img src={p.image} alt={p.name} loading="lazy" />
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .partners {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partner {
    display: grid;
    place-items: center;
    height: 6rem;
    padding: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .partner img {
    max-height: 100%;
    object-fit: contain;
  }
</style>
