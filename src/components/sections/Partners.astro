---
import type { Lang, Site } from '../../content/schema';
import { ui } from '../../i18n/ui';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  site: Site;
}

const { lang, site } = Astro.props;
---

<Section id="partners" title={ui[lang].sections.partners} tone="surface">
  <ul class="partners">
    {
      site.partners.map((p) => (
        <li>
          <a class="partner" href={p.href} target="_blank" rel="noopener" title={p.name}>
            <img src={p.image} alt={p.name} loading="lazy" />
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .partners {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partner {
    display: grid;
    place-items: center;
    height: 7rem;
    padding: 1rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    transition: background-color 0.2s;
  }

  .partner img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 5rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter 0.2s,
      opacity 0.2s;
  }

  .partner:hover {
    background: var(--color-primary-soft);
  }

  .partner:hover img {
    filter: none;
    opacity: 1;
  }
</style>
