---
import type { Conference, Lang } from '../../content/schema';
import { ui } from '../../i18n/ui';
import { countdownTarget, deadlinesByDay, isFinished } from '../../lib/conference';
import { daysUntil, deadlineState, formatDate, formatRange, pluralDays, toIso } from '../../lib/dates';

interface Props {
  lang: Lang;
  conference: Conference;
}

// Rendered with the build date; src/scripts/date-states.ts recomputes the
// data-* states on the visitor's date (contract shared with that script).
const { lang, conference: c } = Astro.props;
const t = ui[lang];
const now = new Date();
const countdown = c.deadlines.find((d) => d.countdown);
const countdownIso = countdown ? toIso(countdown.date) : null;
const target = countdownTarget(c, now);
const startIso = toIso(c.dates.start);
const endIso = toIso(c.dates.end);

/** "25 січня 2026" → big "25", small "січня 2026". */
const split = (formatted: string) => {
  const [day, ...rest] = formatted.split(' ');
  return { day, rest: rest.join(' ') };
};
---

<section id="dates" class="dates" aria-labelledby="dates-title">
  <div class="container">
    <div class="dates__panel">
      <div class="dates__head">
        <h2 id="dates-title" class="dates__title">{t.sections.dates}</h2>
        {
          countdownIso && (
            <p class="dates__countdown" data-countdown={countdownIso} data-lang={lang} hidden={!target}>
              {t.countdownPrefix} <strong>{pluralDays(Math.max(0, daysUntil(countdownIso, now)), lang)}</strong>
            </p>
          )
        }
        <p class="dates__finished" data-finished-after={endIso} hidden={!isFinished(c, now)}>{t.finished}</p>
      </div>
      <ol class="dates__list">
        {
          // One card per day: in 2026 four of the five deadlines fall on 25 January, and a card each
          // would push the key dates onto a second row.
          deadlinesByDay(c, lang).map(({ iso, titles }) => {
            const { day, rest } = split(formatDate(iso, lang));
            return (
              <li class="date-card" data-deadline={iso} data-state={deadlineState(iso, now)}>
                <p class="date-card__when">
                  <span class="date-card__day">{day}</span> {rest}
                </p>
                {titles.length === 1 ? (
                  <p class="date-card__title">{titles[0]}</p>
                ) : (
                  <ul class="date-card__titles">
                    {titles.map((title) => (
                      <li>{title}</li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
        <li class="date-card date-card--conference" data-deadline={endIso} data-state={deadlineState(endIso, now)}>
          <p class="date-card__when">
            <span class="date-card__day">{split(formatRange(startIso, endIso, lang)).day}</span>
            {split(formatRange(startIso, endIso, lang)).rest}
          </p>
          <p class="date-card__title">{t.conferenceDates}</p>
          <p class="date-card__note">{c.venue.place[lang]}</p>
        </li>
      </ol>
    </div>
  </div>
</section>

<script>
  import '../../scripts/date-states';
</script>

<style>
  .dates {
    position: relative;
    z-index: 1;
    margin-top: clamp(-5rem, -8vw, -3rem);
  }

  .dates__panel {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--color-primary-deep);
    color: var(--color-on-dark);
    box-shadow: 0 20px 50px rgb(16 36 58 / 25%);
  }

  .dates__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }

  .dates__title {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    color: #fff;
  }

  .dates__countdown,
  .dates__finished {
    margin: 0;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .dates__countdown {
    background: rgb(255 255 255 / 10%);
  }

  .dates__countdown strong {
    color: #fff;
  }

  .dates__finished {
    background: var(--color-accent);
    color: #fff;
  }

  /* All key dates in one row: as many equal columns as there are cards. */
  .dates__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .date-card {
    padding: 1.1rem 1.25rem 1.25rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    transition: opacity 0.2s;
  }

  .date-card p {
    margin: 0;
  }

  .date-card__when {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-on-dark-muted);
  }

  .date-card__day {
    display: block;
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.05;
    color: #fff;
  }

  .date-card__title {
    margin-top: 0.75rem !important;
    font-weight: 800;
    line-height: 1.35;
    color: #fff;
  }

  .date-card__titles {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .date-card__titles li {
    position: relative;
    padding-left: 0.9rem;
    font-weight: 800;
    line-height: 1.35;
    color: #fff;
  }

  .date-card__titles li + li {
    margin-top: 0.4rem;
  }

  .date-card__titles li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-on-dark-muted);
  }

  .date-card__note {
    margin-top: 0.25rem !important;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-on-dark-muted);
  }

  .date-card[data-state='past'] {
    opacity: 0.45;
  }

  .date-card[data-state='today'] {
    border-color: #fff;
  }

  .date-card--conference,
  .date-card--conference[data-state='past'] {
    opacity: 1;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .date-card--conference .date-card__when,
  .date-card--conference .date-card__note {
    color: rgb(255 255 255 / 85%);
  }

  /* Phones: one compact row per date (date left, what right) instead of four tall cards. */
  /* Tablets: three columns would squeeze four events into one narrow card; wrap instead. */
  @media (max-width: 960px) {
    .dates__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    }
  }

  @media (max-width: 640px) {
    .dates__list {
      gap: 0.5rem;
    }

    .date-card {
      display: grid;
      grid-template-columns: 5.25rem 1fr;
      column-gap: 1rem;
      align-items: start;
      padding: 0.85rem 1rem;
    }

    .date-card__when {
      grid-row: 1 / span 2;
      font-size: 0.82rem;
      line-height: 1.3;
    }

    .date-card__day {
      font-size: 1.75rem;
    }

    .date-card__title,
    .date-card__titles {
      margin-top: 0.15rem !important;
      font-size: 0.95rem;
    }
  }
</style>
