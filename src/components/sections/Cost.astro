---
import type { Conference, Lang } from '../../content/schema';
import { ui } from '../../i18n/ui';
import { md, mdInline } from '../../lib/markdown';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
const t = ui[lang];
const cost = c.cost[lang];
---

<Section id="cost" title={t.sections.cost} tone="surface">
  <div class="prices">
    {
      cost.items.map((item) => (
        <div class="card price">
          <p class="price__label" set:html={mdInline(item.label)} />
          <p class="price__amount">
            {item.amount}
            {item.unit && <span class="price__unit">{item.unit}</span>}
          </p>
          {item.note && <div class="prose price__note" set:html={md(item.note)} />}
        </div>
      ))
    }
  </div>
  <div class="cost__payment">
    <h4>{t.sections.payment}</h4>
    <div class="prose" set:html={md(cost.payment)} />
  </div>
</Section>

<style>
  .prices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }

  .price__label {
    margin: 0 0 1.25rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .price__amount {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary-deep);
  }

  .price__unit {
    margin-left: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .price__note {
    margin-top: 0.75rem;
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .price__note :global(p) {
    margin: 0;
  }

  .cost__payment {
    margin-top: 2rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-primary-soft);
  }

  .cost__payment {
    overflow-wrap: anywhere;
  }

  .cost__payment h4 {
    margin-top: 0;
  }
</style>
