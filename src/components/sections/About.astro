---
import { Image } from 'astro:assets';
import politekhnik from '../../assets/photos/politekhnik-2.jpg';
import type { Conference, Lang } from '../../content/schema';
import { ui } from '../../i18n/ui';
import { md } from '../../lib/markdown';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
const t = ui[lang];
---

<Section id="about" title={t.sections.about}>
  <h4 class="about__label">{t.sections.organizers}</h4>
  <ul class="organizers">
    {
      c.organizers.map((o) => (
        <li class:list={['organizer', { 'organizer--with-logo': o.logo }]}>
          {o.logo && <img class="organizer__watermark" src={o.logo} alt="" loading="lazy" />}
          <span class="organizer__name">{o.name[lang]}</span>
        </li>
      ))
    }
  </ul>

  <article class="venue">
    <Image
      class="venue__photo"
      src={politekhnik}
      widths={[425, 850]}
      sizes="(min-width: 760px) 24rem, 100vw"
      alt={c.venue.place[lang]}
    />
    <div class="venue__text">
      <h4 class="about__label">{t.sections.venue}</h4>
      <h3 class="venue__place">{c.venue.place[lang]}</h3>
      <div class="prose" set:html={md(c.venue.description[lang])} />
    </div>
    <div class="venue__map">
      <iframe
        class="map-frame"
        src={c.venue.mapEmbedUrl}
        title={`${t.sections.venue}: ${c.venue.place[lang]}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
      <a class="venue__map-link" href={c.venue.mapLink} target="_blank" rel="noopener">{t.openMap} ↗</a>
    </div>
  </article>
</Section>

<style>
  .about__label {
    margin-top: 0;
  }

  .organizers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The organizer's logo is a large, faded watermark cropped by the card edge. */
  .organizer {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 6rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgb(16 36 58 / 6%);
    overflow: hidden;
  }

  .organizer--with-logo {
    padding-right: 7.75rem;
  }

  /* A fixed frame bleeding off the right edge: round seals fill it and get cropped,
     wide wordmarks shrink to fit instead of running under the name. */
  .organizer__watermark {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -1.75rem;
    width: 9.5rem;
    height: 170%;
    max-width: none;
    object-fit: contain;
    opacity: 0.4;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .organizer__name {
    font-weight: 700;
    line-height: 1.35;
  }

  .venue {
    display: grid;
    margin-top: 2.5rem;
    border-radius: calc(var(--radius) * 1.5);
    background: var(--color-surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .venue :global(.venue__photo) {
    display: block;
    width: 100%;
    height: 16rem;
    object-fit: cover;
  }

  .venue__text {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    max-width: 46rem;
  }

  .venue__place {
    margin: 0 0 0.75rem;
  }

  .venue__map {
    position: relative;
  }

  .venue__map .map-frame {
    height: 20rem;
    border-radius: 0;
  }

  .venue__map-link {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (min-width: 760px) {
    .venue {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    .venue :global(.venue__photo) {
      height: 100%;
      min-height: 22rem;
    }

    .venue__map {
      grid-column: 1 / -1;
    }
  }
</style>
