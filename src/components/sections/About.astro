---
import { Image } from 'astro:assets';
import politekhnik from '../../assets/photos/politekhnik-2.jpg';
import type { Conference, Lang } from '../../content/schema';
import { ui } from '../../i18n/ui';
import { organizerRows } from '../../lib/conference';
import { md } from '../../lib/markdown';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
const t = ui[lang];
const loc = c.venue.location;
const rows = organizerRows(c.organizers);
---

<Section id="about" title={t.sections.about}>
  <h4 class="about__label">{t.sections.organizers}</h4>
  <div class="organizers">
    {
      rows.map((row) => (
        <ul class="organizers__row" data-kind={row[0].kind} style={`--n: ${row.length}`}>
          {row.map((o) => (
            <li>
              <a
                class:list={['organizer', { 'organizer--with-logo': o.logo }]}
                href={o.href}
                target="_blank"
                rel="noopener"
              >
                {o.logo && <img class="organizer__watermark" src={o.logo} alt="" loading="lazy" />}
                <span class="organizer__name">{o.name[lang]}</span>
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  {
    // Online-only years have no location: no photo, address or map, only the place and how to join.
    loc ? (
      <article class="venue">
        <Image
          class="venue__photo"
          src={politekhnik}
          widths={[425, 850]}
          sizes="(min-width: 760px) 24rem, 100vw"
          alt={c.venue.place[lang]}
        />
        <div class="venue__text">
          <h4 class="about__label">{t.sections.venue}</h4>
          <h3 class="venue__place">{c.venue.place[lang]}</h3>
          <div class="prose" set:html={md(c.venue.description[lang])} />
          <dl class="venue__facts">
            <dt>{loc.name[lang]}</dt>
            <dd>
              <a href={loc.url[lang]} target="_blank" rel="noopener">
                {loc.address[lang]}
              </a>
            </dd>
            {loc.director && (
              <dd>
                {t.venueDirector}: {loc.director[lang]}
              </dd>
            )}
            <dd>{c.venue.format[lang]}</dd>
          </dl>
        </div>
        <div class="venue__map">
          <iframe
            class="map-frame"
            src={loc.mapEmbedUrl}
            title={`${t.sections.venue}: ${c.venue.place[lang]}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
          <a class="venue__map-link" href={loc.mapLink} target="_blank" rel="noopener">
            {t.openMap} ↗
          </a>
        </div>
      </article>
    ) : (
      <article class="venue venue--online">
        <div class="venue__text">
          <h4 class="about__label">{t.sections.venue}</h4>
          <h3 class="venue__place">{c.venue.place[lang]}</h3>
          <div class="prose" set:html={md(c.venue.description[lang])} />
        </div>
      </article>
    )
  }
</Section>

<style>
  .venue__facts {
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }

  .venue__facts dt {
    font-weight: 700;
    color: var(--color-primary-deep);
  }

  .venue__facts dd {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
  }

  .about__label {
    margin-top: 0;
  }

  /* One row per kind, in the agreed order: the ministry across the whole width, then the universities,
     then the associations. Narrow screens stack every card. */
  .organizers {
    display: grid;
    gap: 0.75rem;
  }

  .organizers__row {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .organizers__row {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }

  /* The ministry leads: a taller card, a larger name and seal. */
  [data-kind='ministry'] .organizer {
    min-height: 7.5rem;
    padding-left: 1.75rem;
    background: linear-gradient(100deg, var(--color-surface) 55%, var(--color-primary-soft));
  }


  [data-kind='ministry'] .organizer__name {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    color: var(--color-primary-deep);
  }

  /* The larger seal needs room the phone width does not have. */
  @media (min-width: 640px) {
    [data-kind='ministry'] .organizer--with-logo {
      padding-right: 11rem;
    }

    [data-kind='ministry'] .organizer__watermark {
      right: -2.5rem;
      width: 13rem;
    }
  }

  /* The organizer's logo is a large, faded watermark cropped by the card edge. */
  .organizer {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    height: 100%;
    min-height: 6rem;
    color: var(--color-text);
    text-decoration: none;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgb(16 36 58 / 6%);
    overflow: hidden;
  }

  .organizer--with-logo {
    padding-right: 7.75rem;
  }

  /* A fixed frame bleeding off the right edge: round seals fill it and get cropped,
     wide wordmarks shrink to fit instead of running under the name. */
  .organizer__watermark {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -1.75rem;
    width: 9.5rem;
    height: 170%;
    max-width: none;
    object-fit: contain;
    opacity: 0.4;
    transform: translateY(-50%);
    transition: opacity 0.2s;
    pointer-events: none;
  }

  .organizer:hover,
  .organizer:focus-visible {
    color: var(--color-primary-deep);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .organizer:hover .organizer__watermark,
  .organizer:focus-visible .organizer__watermark {
    opacity: 1;
  }

  .organizer__name {
    font-weight: 700;
    line-height: 1.35;
  }

  .venue {
    display: grid;
    margin-top: 2.5rem;
    border-radius: calc(var(--radius) * 1.5);
    background: var(--color-surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .venue :global(.venue__photo) {
    display: block;
    width: 100%;
    height: 16rem;
    object-fit: cover;
  }

  .venue__text {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    max-width: 46rem;
  }

  .venue__place {
    margin: 0 0 0.75rem;
  }

  .venue__map {
    position: relative;
  }

  .venue__map .map-frame {
    height: 20rem;
    border-radius: 0;
  }

  .venue__map-link {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (min-width: 760px) {
    .venue:not(.venue--online) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    .venue :global(.venue__photo) {
      height: 100%;
      min-height: 22rem;
    }

    .venue__map {
      grid-column: 1 / -1;
    }
  }
</style>
