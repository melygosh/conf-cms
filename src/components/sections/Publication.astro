---
import type { Conference, Lang } from '../../content/schema';
import { ui } from '../../i18n/ui';
import { md } from '../../lib/markdown';
import RegisterButton from '../RegisterButton.astro';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
---

<Section id="publication" title={ui[lang].sections.publication}>
  <p class="publication__lead">{c.publication.summary[lang]}</p>
  <div class="publication">
    <div class="publication__rules">
      <div class="prose" set:html={md(c.publication.rules[lang])} />
      <RegisterButton lang={lang} conference={c} label={`${ui[lang].submitAbstract} →`} class="publication__submit" />
    </div>
    <div class="card prose publication__format" set:html={md(c.publication.formatting[lang])} />
  </div>
</Section>

<style>
  .publication__lead {
    max-width: 52rem;
    margin: 0 0 1.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.5;
  }

  .publication {
    display: grid;
    gap: 2rem;
  }

  .publication__submit {
    margin-top: 1.25rem;
  }

  .publication__format {
    font-size: 0.95rem;
  }

  @media (min-width: 1000px) {
    .publication {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
      gap: 3rem;
      align-items: start;
    }
  }
</style>
