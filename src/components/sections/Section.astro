---
interface Props {
  id: string;
  title: string;
  tone?: 'plain' | 'tinted';
}

const { id, title, tone = 'plain' } = Astro.props;
---

<section id={id} class:list={['section', `section--${tone}`]}>
  <div class="container">
    <h2 class="section__title">{title}</h2>
    <slot />
  </div>
</section>

<style>
  .section {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    border-top: 1px solid var(--color-border);
  }

  .section--tinted {
    background: var(--color-surface);
  }

  .section__title {
    margin-top: 0;
  }
</style>
