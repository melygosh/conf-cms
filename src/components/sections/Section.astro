---
interface Props {
  id: string;
  title: string;
  /** Smaller line next to the title. */
  subtitle?: string;
  /** Show the running section number ("01", "02", …) before the title. */
  numbered?: boolean;
  tone?: 'plain' | 'surface';
  /** Hide the section once this date has passed (see src/scripts/date-states.ts). */
  hiddenAfter?: string;
  hidden?: boolean;
}

const { id, title, subtitle, numbered = true, tone = 'plain', hiddenAfter, hidden } = Astro.props;
---

<section id={id} class:list={['section', `section--${tone}`]} data-hidden-after={hiddenAfter} hidden={hidden}>
  <div class="container">
    <header class="section__head">
      {numbered && <span class="eyebrow section__number" aria-hidden="true" />}
      <h2 class="section__title">{title}</h2>
      {subtitle && <p class="section__subtitle">{subtitle}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding: clamp(2.75rem, 6vw, 4.5rem) 0;
  }

  .section--surface {
    background: var(--color-surface);
  }

  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* Numbers come from a CSS counter, so hidden sections (e.g. an empty archive) don't leave gaps. */
  .section__number {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    counter-increment: section;
  }

  .section__number::before {
    content: counter(section, decimal-leading-zero);
  }

  .section__number::after {
    content: '';
    width: 1.75rem;
    height: 2px;
    background: var(--color-accent);
  }

  .section__title {
    margin: 0;
    color: var(--color-primary-deep);
  }

  .section__subtitle {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-muted);
  }
</style>
