---
import type { Conference, Lang } from '../../content/schema';
import { ui } from '../../i18n/ui';
import { md } from '../../lib/markdown';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
---

<Section id="authors" title={ui[lang].sections.authors} subtitle={ui[lang].sections.authorsNote}>
  <div class="accordion">
    {
      c.authors.map((a) => (
        <details class="accordion__item">
          <summary>{a.title[lang]}</summary>
          <div class="prose accordion__body" set:html={md(a.body[lang])} />
        </details>
      ))
    }
  </div>
</Section>

<style>
  .accordion {
    border-top: 1px solid var(--color-border);
  }

  .accordion__item {
    border-bottom: 1px solid var(--color-border);
  }

  .accordion__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-deep);
    list-style: none;
    cursor: pointer;
  }

  .accordion__item summary::-webkit-details-marker {
    display: none;
  }

  .accordion__item summary::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 1.3rem;
    font-weight: 600;
    transition: transform 0.2s;
  }

  .accordion__item[open] summary::after {
    transform: rotate(45deg);
  }

  .accordion__body {
    padding-bottom: 1.5rem;
  }

  .accordion__body :global(img) {
    float: right;
    width: min(11rem, 35%);
    margin: 0 0 1rem 1.5rem;
    border-radius: 4px;
    box-shadow: var(--shadow);
  }

  .accordion__body::after {
    display: block;
    clear: both;
    content: '';
  }
</style>
