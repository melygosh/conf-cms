---
import type { Conference, Lang } from '../../content/schema';
import { ui } from '../../i18n/ui';
import { md } from '../../lib/markdown';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
---

<Section id="authors" title={ui[lang].sections.authors}>
  {
    c.authors.map((a) => (
      <details class="authors__item">
        <summary>{a.title[lang]}</summary>
        <div class="prose authors__body" set:html={md(a.body[lang])} />
      </details>
    ))
  }
</Section>

<style>
  .authors__item {
    border-bottom: 1px solid var(--color-border);
  }

  .authors__item summary {
    padding: 1rem 0;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
  }

  .authors__body {
    padding-bottom: 1rem;
  }

  .authors__body :global(img) {
    float: right;
    width: min(12rem, 35%);
    margin: 0 0 1rem 1.5rem;
    border: 1px solid var(--color-border);
  }

  .authors__body::after {
    display: block;
    clear: both;
    content: '';
  }
</style>
