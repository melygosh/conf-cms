---
import type { Lang, Site } from '../../content/schema';
import { ui } from '../../i18n/ui';
import { md } from '../../lib/markdown';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  site: Site;
}

const { lang, site } = Astro.props;
const t = ui[lang];
---

<Section id="contacts" title={t.sections.contacts}>
  <div class="contacts">
    <div class="contacts__text" set:html={md(site.contacts[lang])} />
    <iframe
      class="map-frame contacts__map"
      src={site.khpiMapEmbedUrl}
      title={t.sections.contacts}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </div>
</Section>

<style>
  .contacts {
    display: grid;
    gap: 1.5rem;
  }

  /* The Markdown is "### Heading" + paragraph pairs; each pair reads as one card. */
  .contacts__text {
    display: grid;
    align-content: start;
  }

  .contacts__text :global(h3) {
    margin: 1rem 0 0;
    padding: 1.1rem 1.25rem 0.2rem;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
  }

  .contacts__text :global(h3:first-child) {
    margin-top: 0;
  }

  .contacts__text :global(p) {
    margin: 0;
    padding: 0.2rem 1.25rem 1.1rem;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--color-surface);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .contacts__text :global(a[href^='tel:']) {
    white-space: nowrap;
  }

  .contacts__map {
    height: 22rem;
  }

  /* Wide screens: the heading/paragraph pairs become a row of cards above the map. */
  @media (min-width: 900px) {
    .contacts__text {
      grid-template-rows: auto 1fr;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      column-gap: 1rem;
    }

    .contacts__text :global(h3) {
      margin-top: 0;
    }
  }
</style>
