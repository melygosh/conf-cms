---
import { getCollection, getEntry } from 'astro:content';
import type { Lang } from '../content/schema';
import Base from '../layouts/Base.astro';
import { assertConferenceFiles, pickCurrent, toRoman } from '../lib/conference';
import { ui } from '../i18n/ui';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import PhotoStrip from './PhotoStrip.astro';
import About from './sections/About.astro';
import Archive from './sections/Archive.astro';
import Authors from './sections/Authors.astro';
import Committees from './sections/Committees.astro';
import Contacts from './sections/Contacts.astro';
import Cost from './sections/Cost.astro';
import Dates from './sections/Dates.astro';
import Partners from './sections/Partners.astro';
import Publication from './sections/Publication.astro';
import Registration from './sections/Registration.astro';
import Topics from './sections/Topics.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const conferenceEntries = await getCollection('conferences');
assertConferenceFiles(conferenceEntries);
const conference = pickCurrent(conferenceEntries.map((e) => e.data));
const archive = (await getCollection('archive'))
  .map((e) => e.data)
  .filter((a) => a.proceedings || a.photos || a.presentations.length > 0)
  .sort((a, b) => b.year - a.year);
const site = (await getEntry('site', 'site'))!.data;

const t = ui[lang];
const title = `${conference.title[lang]} ${conference.year}`;
const description = `${t.editionLine(toRoman(conference.edition))}: ${conference.title[lang]}`;
---

<Base lang={lang} title={title} description={description}>
  <Header lang={lang} year={conference.year} hasArchive={archive.length > 0} />
  <main>
    <Hero lang={lang} conference={conference} proceedings={archive.find((a) => a.year === conference.year)?.proceedings} />
    <Dates lang={lang} conference={conference} />
    <About lang={lang} conference={conference} />
    <PhotoStrip />
    <Topics lang={lang} conference={conference} />
    <Publication lang={lang} conference={conference} />
    <Cost lang={lang} conference={conference} />
    <Authors lang={lang} conference={conference} />
    <Committees lang={lang} conference={conference} />
    <Registration lang={lang} conference={conference} />
    <Archive lang={lang} archive={archive} />
    <Partners lang={lang} site={site} />
    <Contacts lang={lang} site={site} />
  </main>
  <Footer lang={lang} year={conference.year} title={conference.title[lang]} />
</Base>
