---
import { getCollection, getEntry } from 'astro:content';
import type { Lang } from '../content/schema';
import Base from '../layouts/Base.astro';
import { pickCurrent, toRoman } from '../lib/conference';
import { ui } from '../i18n/ui';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const conference = pickCurrent((await getCollection('conferences')).map((e) => e.data));
const archive = (await getCollection('archive'))
  .map((e) => e.data)
  .filter((a) => a.photos || a.presentations.length > 0)
  .sort((a, b) => b.year - a.year);
const site = (await getEntry('site', 'site'))!.data;

const t = ui[lang];
const title = `${conference.title[lang]} ${conference.year}`;
const description = `${t.editionLine(toRoman(conference.edition))}: ${conference.title[lang]}`;
---

<Base lang={lang} title={title} description={description}>
  <Header lang={lang} year={conference.year} hasArchive={archive.length > 0} />
  <main>
    <Hero lang={lang} conference={conference} />
  </main>
  <Footer lang={lang} year={conference.year} title={conference.title[lang]} />
</Base>
