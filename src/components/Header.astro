---
import type { Lang } from '../content/schema';
import { homeHref, otherLang, ui } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  year: number;
  hasArchive: boolean;
}

const { lang, year, hasArchive } = Astro.props;
const t = ui[lang];
const links = [
  ['about', t.nav.about],
  ['dates', t.nav.dates],
  ['cost', t.nav.cost],
  ['authors', t.nav.authors],
  ['committees', t.nav.committees],
  ...(hasArchive ? [['archive', t.nav.archive]] : []),
  ['contacts', t.nav.contacts],
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={homeHref[lang]}>
      <Logo year={year} width={140} />
    </a>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="site-header__toggle-bars" aria-hidden="true"></span>
      <span class="visually-hidden">{t.menu}</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label={t.menu}>
      <ul>
        {links.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ul>
      <a
        class="site-nav__lang"
        href={homeHref[otherLang(lang)]}
        hreflang={otherLang(lang)}
        lang={otherLang(lang)}
        title={t.langSwitchTitle}
        data-lang-switch>{t.langSwitchLabel}</a
      >
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }

  // Keep the reader on the same section when switching language.
  const langLink = document.querySelector<HTMLAnchorElement>('[data-lang-switch]');
  langLink?.addEventListener('click', () => {
    if (location.hash) langLink.href = langLink.pathname + location.hash;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-height);
  }

  .site-header__logo {
    flex: none;
    padding: 0.35rem 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--color-primary);
  }

  .site-nav .site-nav__lang {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-primary);
    border-radius: 2px;
    color: var(--color-primary);
  }

  .site-header__toggle {
    display: none;
  }

  @media (max-width: 960px) {
    .site-header__toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--color-border);
      border-radius: 2px;
      background: var(--color-surface);
      cursor: pointer;
    }

    .site-header__toggle-bars,
    .site-header__toggle-bars::before,
    .site-header__toggle-bars::after {
      display: block;
      width: 1.25rem;
      height: 2px;
      background: var(--color-text);
      content: '';
    }

    .site-header__toggle-bars::before {
      transform: translateY(-6px);
    }

    .site-header__toggle-bars::after {
      transform: translateY(4px);
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem var(--gutter) 1.25rem;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0.75rem;
    }

    .site-nav a {
      font-size: 1rem;
    }
  }
</style>
