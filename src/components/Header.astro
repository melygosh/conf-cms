---
import type { Lang } from '../content/schema';
import { homeHref, otherLang, ui } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  year: number;
  hasArchive: boolean;
}

const { lang, year, hasArchive } = Astro.props;
const t = ui[lang];
const links = [
  ['about', t.nav.about],
  ['dates', t.nav.dates],
  ['cost', t.nav.cost],
  ['authors', t.nav.authors],
  ['committees', t.nav.committees],
  ...(hasArchive ? [['archive', t.nav.archive]] : []),
  ['contacts', t.nav.contacts],
];
---

<!-- Sits over the hero photo at the top of the page and turns into a compact bar on scroll. -->
<header class="site-header" data-scrolled="false">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={homeHref[lang]}>
      <Logo year={year} width={180} />
    </a>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="site-header__toggle-bars" aria-hidden="true"></span>
      <span class="visually-hidden">{t.menu}</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label={t.menu}>
      <ul>
        {links.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ul>
      <a
        class="site-nav__lang"
        href={homeHref[otherLang(lang)]}
        hreflang={otherLang(lang)}
        lang={otherLang(lang)}
        title={t.langSwitchTitle}
        data-lang-switch>{t.langSwitchLabel}</a
      >
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('site-nav');

  if (header) {
    const update = () => (header.dataset.scrolled = String(window.scrollY > 24));
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  // Keep the reader on the same section when switching language.
  const langLink = document.querySelector<HTMLAnchorElement>('[data-lang-switch]');
  langLink?.addEventListener('click', () => {
    if (location.hash) langLink.href = langLink.pathname + location.hash;
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }

  .site-header[data-scrolled='true'] {
    background: rgb(255 255 255 / 94%);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 0 var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-height);
  }

  .site-header__logo {
    flex: none;
    padding: 0.75rem 0;
    transition: padding 0.2s;
  }

  .site-header__logo :global(.logo) {
    width: 180px;
    transition: width 0.2s;
  }

  .site-header[data-scrolled='true'] .site-header__logo {
    padding: 0.35rem 0;
  }

  .site-header[data-scrolled='true'] .site-header__logo :global(.logo) {
    width: 104px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    color: var(--color-text);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--color-accent);
  }

  .site-nav .site-nav__lang {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .site-nav .site-nav__lang:hover {
    background: var(--color-accent);
    color: #fff;
  }

  .site-header__toggle {
    display: none;
  }

  @media (max-width: 1080px) {
    .site-header__logo :global(.logo) {
      width: 140px;
    }

    .site-header__toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 0;
      border-radius: 999px;
      background: var(--color-surface);
      box-shadow: var(--shadow);
      cursor: pointer;
    }

    .site-header__toggle-bars,
    .site-header__toggle-bars::before,
    .site-header__toggle-bars::after {
      display: block;
      width: 1.2rem;
      height: 2px;
      background: var(--color-text);
      content: '';
    }

    .site-header__toggle-bars::before {
      transform: translateY(-6px);
    }

    .site-header__toggle-bars::after {
      transform: translateY(4px);
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: var(--gutter);
      right: var(--gutter);
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem 1.5rem;
      border-radius: var(--radius);
      background: var(--color-surface);
      box-shadow: var(--shadow);
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0.8rem;
    }

    .site-nav a {
      font-size: 1.05rem;
    }
  }
</style>
