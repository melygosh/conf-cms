---
import type { Lang } from '../content/schema';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  year: number;
  title: string;
}

const { lang, year, title } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <p>{title} · {year}</p>
    <p class="site-footer__credit">{ui[lang].footer}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 2.5rem 0;
    background: var(--color-primary-deep);
    color: var(--color-on-dark-muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    margin: 0.25rem 0;
  }

  .site-footer__credit {
    font-size: 0.8rem;
  }
</style>
