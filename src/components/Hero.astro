---
import type { Conference, Lang } from '../content/schema';
import { isFinished, toRoman } from '../lib/conference';
import { formatRange, toIso } from '../lib/dates';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
const t = ui[lang];
const endIso = toIso(c.dates.end);
const finished = isFinished(c, new Date());
---

<section class="hero">
  <div class="container">
    <p class="eyebrow">{t.editionLine(toRoman(c.edition))}</p>
    <h1 class="hero__title">{c.title[lang]}</h1>
    <p class="hero__meta">
      <span class="hero__dates">{formatRange(toIso(c.dates.start), toIso(c.dates.end), lang)}</span>
      <span aria-hidden="true"> · </span>
      <span>{c.venue.place[lang]}</span>
    </p>
    <p class="hero__actions">
      <a
        class="button button--accent"
        href={c.links.registration[lang]}
        target="_blank"
        rel="noopener"
        data-hidden-after={endIso}
        hidden={finished}>{t.register}</a
      >
      <a class="hero__letter" href={c.links.infoLetter[lang]} target="_blank" rel="noopener">{t.infoLetter}</a>
    </p>
    <slot />
  </div>
</section>

<style>
  .hero {
    padding: clamp(2.5rem, 7vw, 4.5rem) 0 1rem;
  }

  .hero__title {
    max-width: 30ch;
    margin: 0.5rem 0 1rem;
  }

  .hero__meta {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-muted);
  }

  .hero__dates {
    color: var(--color-accent);
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 0 0 2rem;
  }

  .hero__letter {
    font-weight: 600;
  }
</style>
