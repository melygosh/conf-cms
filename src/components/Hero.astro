---
import { Picture } from 'astro:assets';
import carpathians from '../assets/photos/carpathians.jpg';
import type { Conference, Lang } from '../content/schema';
import { toRoman } from '../lib/conference';
import { formatRange, toIso } from '../lib/dates';
import { ui } from '../i18n/ui';
import RegisterButton from './RegisterButton.astro';

interface Props {
  lang: Lang;
  conference: Conference;
}

const { lang, conference: c } = Astro.props;
const t = ui[lang];
const endIso = toIso(c.dates.end);
---

<section class="hero">
  <!-- The Carpathians the logo is drawn after; the left side fades to snow so the logo and text sit on light. -->
  <Picture
    class="hero__photo"
    src={carpathians}
    formats={['avif', 'webp']}
    widths={[800, 1300]}
    sizes="100vw"
    alt=""
    loading="eager"
    fetchpriority="high"
  />
  <div class="container hero__content">
    <p class="eyebrow">{t.editionLine(toRoman(c.edition))}</p>
    <h1 class="hero__title">{c.title[lang]}</h1>
    <p class="hero__meta">
      <span class="hero__dates">{formatRange(toIso(c.dates.start), endIso, lang)}</span>
      <span class="hero__place">{c.venue.place[lang]}</span>
    </p>
    <p class="hero__actions">
      <RegisterButton lang={lang} conference={c} label={t.register} />
      <a class="button button--ghost" href={c.links.infoLetter[lang]} target="_blank" rel="noopener">{t.infoLetter}</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(46rem, 92vh);
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-height) + 7rem) 0 clamp(6rem, 12vw, 9rem);
    overflow: hidden;
  }

  .hero :global(.hero__photo),
  .hero :global(.hero__photo img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 35%;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 80%) 0%, rgb(255 255 255 / 0%) 20%),
      linear-gradient(90deg, rgb(250 250 248 / 95%) 0%, rgb(250 250 248 / 88%) 40%, rgb(250 250 248 / 45%) 56%, rgb(250 250 248 / 0%) 70%),
      linear-gradient(0deg, var(--color-bg) 0%, rgb(246 244 239 / 0%) 12%);
  }

  .hero__content {
    position: relative;
  }

  .hero__content > * {
    max-width: 44rem;
  }

  .hero__title {
    margin: 0.75rem 0 1.25rem;
    font-size: clamp(2rem, 3.6vw, 3rem);
    color: var(--color-primary-deep);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 0 0 2rem;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
  }

  .hero__dates {
    color: var(--color-accent);
    font-weight: 700;
  }

  .hero__place {
    position: relative;
    padding-left: 1.25rem;
    color: var(--color-muted);
  }

  .hero__place::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-primary);
    transform: translateY(-50%);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 0;
      padding-top: calc(var(--header-height) + 5.5rem);
    }

    .hero::after {
      background:
        linear-gradient(180deg, rgb(255 255 255 / 70%) 0%, rgb(255 255 255 / 0%) 22%, rgb(250 250 248 / 78%) 42%, rgb(250 250 248 / 94%) 70%, var(--color-bg) 100%);
    }

    .hero :global(.hero__photo),
    .hero :global(.hero__photo img) {
      object-position: 70% 30%;
    }
  }
</style>
